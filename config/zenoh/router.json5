{
  mode: "router",
  listen: {
    endpoints: ["tcp/[::]:7447"],
    exit_on_failure: true,
  },
  scouting: {
    multicast: {
      enabled: false,
    },
    gossip: {
      enabled: true,
    },
  },
  timestamping: {
    enabled: true,
    drop_future_timestamp: false,
  },
  transport: {
    shared_memory: {
      enabled: false,
    },
  },
}
