ROS_DOMAIN_ID=42
CONTAINER_ROS_DISTRO=jazzy
RMW=cyclonedds
IMAGE_PREFIX=curtmini-piper

CAN_PORT=can0
LPMS_DEVICE=/dev/ttyLPMSCA3D00510053
JOYSTICK_DEVICE=/dev/input/js0
START_JOYSTICK=true
START_IMU=true

ARM_MOUNT_XYZ=0 0 0.18
ARM_MOUNT_RPY=0 0 0
TCP_OFFSET_XYZ=0 0 0
TCP_OFFSET_RPY=0 0 0

# Simulation launch defaults; use curtmini_piper_map for the office world.
SIM_WORLD=curtmini_piper
SIM_USE_HOKUYO=true
SIM_SPAWN_X=0.0
SIM_SPAWN_Y=-2.0
SIM_SPAWN_Z=0.16
SIM_SPAWN_YAW=0.0

MOVEIT_PLAN_ONLY=true
ZENOH_ROUTER_CHECK_ATTEMPTS=30
DISPLAY=:0
LIBGL_ALWAYS_SOFTWARE=1

OCI_SOURCE=
OCI_REVISION=unknown

# Local workspace: runtime source mounts for compose.workspace.yaml
CURT_MINI_SOURCE=../rob4_fraunhofer_ws/src/curt_mini
CURTMINI_PIPER_SOURCE=../rob4_fraunhofer_ws/src/curtmini_piper
AGX_ARM_URDF_SOURCE=../rob4_fraunhofer_ws/src/piper_driver/agx_arm_urdf
CURTMINI_PIPER_GZ_SIM_SOURCE=../rob4_fraunhofer_ws/src/curtmini_piper_simulation/curtmini_piper_gz_sim
NEO_GZ_WORLDS_SOURCE=../rob4_fraunhofer_ws/src/curtmini_piper_simulation/neo_gz_worlds
