CONTAINER_ROS_DISTRO=jazzy
RMW=cyclonedds
ROS_DOMAIN_ID=42

# Use curtmini_piper_map for the office environment.
SIM_WORLD=curtmini_piper
SIM_USE_HOKUYO=true
SIM_USE_CAMERAS=true

# Required when starting the two physical camera services.
BASE_CAMERA_SERIAL=
TOOL_CAMERA_SERIAL=

# Regular tools images build from the tools repository's published main branch.
# The repository is private. Use an SSH agent with access to it, or set
# CURTMINI_PIPER_TOOLS_SSH_AUTH=default=/absolute/path/to/your/private_key.
# To test unpublished local tools code, use compose.workspace.yaml instead.

# Regular application images (simulation or hardware).
COMPOSE_FILE=compose.yaml:compose.cyclonedds.yaml:compose.gui.yaml
# Optional local source development (build workspace-builder first):
# COMPOSE_FILE=compose.yaml:compose.cyclonedds.yaml:compose.workspace.yaml:compose.gui.yaml
