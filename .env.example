CONTAINER_ROS_DISTRO=jazzy
RMW=cyclonedds
ROS_DOMAIN_ID=42

# Use curtmini_piper_map for the office environment.
SIM_WORLD=curtmini_piper
SIM_USE_HOKUYO=true

# Local simulation: build workspace-builder before launching.
COMPOSE_FILE=compose.yaml:compose.cyclonedds.yaml:compose.workspace.yaml:compose.gui.yaml
# Regular application images (without local workspace):
# COMPOSE_FILE=compose.yaml:compose.cyclonedds.yaml:compose.gui.yaml
